DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database_name>
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database_name>


CLUSTER_API_KEY=<api_key>

# Docker
TEAR_DOWN_SANDBOX_AFTER_RUN=<true/false>


#Planning Agent
USE_TOOLS=<true/false>
PLANNER_MAX_TOOL_STEPS=<number>

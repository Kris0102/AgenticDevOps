 # Postgres — docker-compose initializes the DB from these; the app (db.py) and
# Alembic build the connection URL from them. Single source of truth.
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database_name>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: point the app + Alembic at an EXTERNAL Postgres (RDS/Supabase/Neon).
# If set, OVERRIDES the POSTGRES_* parts above. Leave unset for the local
# docker-compose database (compose still needs the POSTGRES_* vars regardless).
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database_name>


CLUSTER_API_KEY=<api_key>

# GitHub — required for private repos; public repos work without it
GITHUB_TOKEN=<ghp_...>

# Docker
TEAR_DOWN_SANDBOX_AFTER_RUN=<true/false>


#Planning Agent
USE_TOOLS=<true/false>
PLANNER_MAX_TOOL_STEPS=<number>
PLANNER_MAX_SYNTHESIS_ATTEMPTS=<number>
PLANNER_TIMEOUT_SECONDS=<number>       # planner LLM timeout (default 60)

#Reviewer Agent
USE_TOOLS=<true/false>
REVIEWER_MAX_TOOL_STEPS=<number>
REVIEWER_MAX_SYNTHESIS_ATTEMPTS=<number> # default 3
REVIEWER_TIMEOUT_SECONDS=<number>      # reviewer LLM timeout (default 60)

#Coder
CODER_MAX_TOOL_STEPS=<number>          # ReAct rounds (default 16)
CODER_MAX_EMPTY_DIFF_RETRIES=<number>  # re-prompts on empty repo.diff (default 2)
CODER_TIMEOUT_SECONDS=<number>         # LLM request timeout (default 120)

#LLM
LLM_MODEL=<provider/model>             # default google/gemma-4-31B-it
LLM_RETRIES=<number>
LLM_MAX_OUTPUT_TOKENS=<number>         # optional; blank/unset = no cap (provider/model default)

#Context Engine (semantic memory)
EMBEDDING_MODEL=<sentence-transformers model>  # default all-MiniLM-L6-v2 (384-dim).
                                               # Changing it requires matching EMBEDDING_DIM + a new code_chunks migration.

#Logging
LOG_COLORS=<auto/true/false>   # auto = color when stdout is a TTY (default). NO_COLOR env also disables.
LOG_JSON=<true/false>          # true → one JSON object per line (prod); false → pretty console (default)

# Global threshold for all categories. DEBUG = show everything.
LOG_LEVEL=<DEBUG/INFO/WARNING/ERROR/CRITICAL>   # default INFO

# Per-category overrides — uncomment to raise/lower one channel independently of LOG_LEVEL.
# Value is a level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL_TOOL=DEBUG          # ToolGateway: which tools ran / were denied + results
# LOG_LEVEL_SEMANTIC=DEBUG      # Context Engine: ingest counts, search queries + hits
# LOG_LEVEL_PLANNER=DEBUG       # Planner: investigation steps, synthesis
# LOG_LEVEL_REVIEWER=DEBUG      # Plan Reviewer
# LOG_LEVEL_CODER=DEBUG         # Coder: attempts, diffs, ReAct transcript
# LOG_LEVEL_TESTER=DEBUG        # Tester
# LOG_LEVEL_REFLECTOR=DEBUG     # Reflector
# LOG_LEVEL_HITL=DEBUG          # Human-in-the-loop gates
# LOG_LEVEL_SANDBOX=DEBUG       # Docker lifecycle / exec
# LOG_LEVEL_BOOTSTRAP=DEBUG     # Bootstrap: clone, sandbox readiness
# LOG_LEVEL_ORCHESTRATOR=DEBUG  # Graph routing / run lifecycle
# LOG_LEVEL_DB=DEBUG            # DB layer

      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "agenticdevops-pg"
          },
          "rawSql": "SELECT llm_model AS model, count(*) AS runs, round(100.0 * count(*) FILTER (WHERE status = 'DONE') / NULLIF(count(*), 0), 1) AS success_pct, round(avg(tokens_used_total)) AS avg_tokens, round(avg(EXTRACT(EPOCH FROM (updated_at - created_at)))) AS avg_duration_s FROM runs WHERE llm_model IS NOT NULL GROUP BY 1 ORDER BY runs DESC;",
          "format": "table"
        }
